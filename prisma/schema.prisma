generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["views"]
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model refresh_token {
  id        Int      @id @default(autoincrement())
  token     String   @db.Text
  userId    Int
  expiresAt DateTime
  users     users    @relation(fields: [userId], references: [id])

  @@index([userId], map: "refresh_token_userId_fkey")
}

model roles {
  id                    Int                     @id @default(autoincrement())
  role_code             String                  @unique(map: "role_code_unique") @db.VarChar(2)
  role_name             String                  @db.VarChar(50)
  role_permissions      role_permissions[]
  temporary_permissions temporary_permissions[]
  users                 users[]
}

model permissions {
  id                    Int                     @id @default(autoincrement())
  permission_code       String                  @unique(map: "permission_code_unique") @db.VarChar(50)
  endpoint              String                  @db.VarChar(255)
  description           String?                 @db.VarChar(255)
  role_permissions      role_permissions[]
  temporary_permissions temporary_permissions[]
}

model role_permissions {
  role_id       Int
  permission_id Int
  roles         roles       @relation(fields: [role_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "role_permissions_ibfk_1")
  permissions   permissions @relation(fields: [permission_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "role_permissions_ibfk_2")

  @@id([role_id, permission_id])
  @@index([permission_id], map: "permission_id")
}

model temporary_permissions {
  id            Int         @id @default(autoincrement())
  permission_id Int
  role_id       Int?
  user_id       Int?
  start_date    DateTime    @db.DateTime(0)
  end_date      DateTime    @db.DateTime(0)
  permissions   permissions @relation(fields: [permission_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "temporary_permissions_ibfk_1")
  roles         roles?      @relation(fields: [role_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "temporary_permissions_ibfk_2")
  users         users?      @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "temporary_permissions_ibfk_3")

  @@index([permission_id], map: "permission_id")
  @@index([role_id], map: "role_id")
  @@index([user_id], map: "user_id")
}

model santri {
  id                                Int                         @id @default(autoincrement())
  nisn                              String                      @db.VarChar(100)
  nis                               String                      @db.VarChar(100)
  nama                              String?                     @db.VarChar(100)
  foto                              String?                     @db.VarChar(100)
  jk                                santri_jk?
  tempat_ttl                        String?                     @db.VarChar(100)
  tgl_ttl                           DateTime?                   @db.Date
  agama                             String?                     @db.VarChar(50)
  kesukuan                          String?                     @db.VarChar(50)
  anak_ke                           Int?
  tinggi                            Decimal?                    @db.Decimal(5, 2)
  berat                             Decimal?                    @db.Decimal(5, 2)
  gol_darah                         String?                     @db.VarChar(3)
  hobi                              String?                     @db.Text
  email                             String?                     @db.VarChar(100)
  id_jenjang                        Int?
  warna_kulit                       String?                     @db.VarChar(100)
  id_master_kategori_status_santri  Int?
  data_beasiswa_santri              data_beasiswa_santri[]
  data_eskul                        data_eskul[]
  data_nilai_eskul                  data_nilai_eskul[]
  data_nilai_kti                    data_nilai_kti[]
  data_prestasi_pelanggaran         data_prestasi_pelanggaran[]
  data_rombel_anggota               data_rombel_anggota[]
  data_tagihan_santri               data_tagihan_santri[]
  ref_master_kategori_status_santri ref_master_kategori?        @relation(fields: [id_master_kategori_status_santri], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "santri_ibfk_1")
  santri_keluarga                   santri_keluarga[]
  santri_kesehatan                  santri_kesehatan[]
  santri_kontak                     santri_kontak[]
  santri_pendidikan                 santri_pendidikan[]
  santri_status                     santri_status[]

  @@index([id_master_kategori_status_santri], map: "santri_ibfk_1")
}

model santri_kesehatan {
  id               Int     @id @default(autoincrement())
  id_santri        Int?
  riwayat_penyakit String? @db.Text
  santri           santri? @relation(fields: [id_santri], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "santri_kesehatan_ibfk_1")

  @@index([id_santri], map: "santri_kesehatan_ibfk_1")
}

model santri_kontak {
  id        Int     @id @default(autoincrement())
  id_santri Int?
  telepon   String? @db.VarChar(100)
  alamat    String? @db.Text
  provinsi  String? @db.VarChar(100)
  kota      String? @db.VarChar(100)
  kode_pos  String? @db.VarChar(100)
  santri    santri? @relation(fields: [id_santri], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "santri_kontak_ibfk_1")

  @@index([id_santri], map: "santri_kontak_ibfk_1")
}

model santri_pendidikan {
  id              Int     @id @default(autoincrement())
  id_santri       Int?
  asal_sekolah    String? @db.VarChar(100)
  alamat_sekolah  String? @db.Text
  no_skhun        String? @db.VarChar(100)
  tahun_skhun     Int?    @db.Year
  nomor_ujian_sd  String? @db.VarChar(100)
  nomor_ujian_smp String? @db.VarChar(100)
  santri          santri? @relation(fields: [id_santri], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "santri_pendidikan_ibfk_1")

  @@index([id_santri], map: "santri_pendidikan_ibfk_1")
}

model santri_status {
  id                 Int       @id @default(autoincrement())
  id_santri          Int?
  tahun_ajaran_masuk String?   @db.VarChar(9)
  tahun_ajaran_tamat String?   @db.VarChar(9)
  tgl_masuk          DateTime? @db.Date
  tgl_keluar         DateTime? @db.Date
  pindahan           String?
  alasan_pindah      String?   @db.Text
  lanjut_ke          String?   @db.VarChar(100)
  santri             santri?   @relation(fields: [id_santri], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "santri_status_ibfk_1")

  @@index([id_santri], map: "santri_status_ibfk_1")
}

model santri_keluarga {
  id               Int              @id @default(autoincrement())
  id_santri        Int?
  nama_ayah        String?          @db.VarChar(100)
  nama_ibu         String?          @db.VarChar(100)
  nama_wali        String?          @db.VarChar(100)
  pendidikan_ayah  pendidikan_enum?
  pendidikan_ibu   pendidikan_enum?
  pekerjaan_ayah   String?          @db.VarChar(100)
  pekerjaan_ibu    String?          @db.VarChar(100)
  pekerjaan_wali   String?          @db.VarChar(100)
  suku_marga       String?          @db.VarChar(100)
  alamat           String?          @db.Text
  telepon_ayah     String?          @db.VarChar(100)
  telepon_ibu      String?          @db.VarChar(100)
  penghasilan_ayah String?          @db.VarChar(100)
  penghasilan_ibu  String?          @db.VarChar(100)
  email_ayah       String?          @db.VarChar(100)
  santri           santri?          @relation(fields: [id_santri], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "santri_keluarga_ibfk_1")

  @@index([id_santri], map: "santri_keluarga_ibfk_1")
}

model data_absensi {
  id                  Int                   @id @default(autoincrement())
  id_kelas            Int
  tanggal             DateTime              @db.Date
  pertemuan_ke        Int
  materi              String?               @db.Text
  created_at          DateTime?             @default(now()) @db.Timestamp(0)
  data_kelas          data_kelas            @relation(fields: [id_kelas], references: [id], onUpdate: Restrict, map: "data_absensi_ibfk_1")
  data_absensi_detail data_absensi_detail[]

  @@index([id_kelas], map: "id_kelas")
}

model data_absensi_detail {
  id               Int              @id @default(autoincrement())
  id_absensi       Int
  id_santri        Int
  id_status        Int
  keterangan       String?          @db.Text
  data_absensi     data_absensi     @relation(fields: [id_absensi], references: [id], onUpdate: Restrict, map: "data_absensi_detail_ibfk_1")
  ref_status_hadir ref_status_hadir @relation(fields: [id_status], references: [id], onUpdate: Restrict, map: "data_absensi_detail_ibfk_2")

  @@index([id_absensi], map: "id_absensi")
  @@index([id_status], map: "id_status")
}

model data_eskul {
  id         Int        @id @default(autoincrement())
  id_santri  Int?
  id_mapel   Int?
  tgl_masuk  DateTime?  @db.Date
  tgl_keluar DateTime?  @db.Date
  santri     santri?    @relation(fields: [id_santri], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "data_eskul_ibfk_1")
  ref_mapel  ref_mapel? @relation(fields: [id_mapel], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "data_eskul_ibfk_2")

  @@index([id_santri], map: "data_eskul_ibfk_1")
  @@index([id_mapel], map: "data_eskul_ibfk_2")
}

model data_kehadiran_pegawai {
  id           Int                            @id @default(autoincrement())
  id_pegawai   Int?
  tgl          DateTime?                      @db.Date
  waktu_masuk  DateTime?                      @db.DateTime(0)
  waktu_keluar DateTime?                      @db.DateTime(0)
  status       data_kehadiran_pegawai_status?
}

model data_kelas {
  id_semester            Int?
  id                     Int                      @id @default(autoincrement())
  id_mapel               Int?
  created_at             DateTime?                @default(now()) @db.Timestamp(0)
  gender                 data_kelas_gender?
  id_kelas_kategori      Int?
  is_aktif               Int                      @default(1)
  kode_kelas             String?                  @db.VarChar(100)
  tahfidz_jadwal         String?                  @db.Text
  tahfidz_target_juz     String?                  @db.VarChar(100)
  tipe                   data_kelas_tipe?
  id_rombel              Int?
  data_absensi           data_absensi[]
  data_rombel            data_rombel?             @relation(fields: [id_rombel], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "data_kelas_ibfk_1")
  ref_mapel              ref_mapel?               @relation(fields: [id_mapel], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "data_kelas_ibfk_2")
  ref_semester           ref_semester?            @relation(fields: [id_semester], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "data_kelas_ibfk_3")
  data_rencana_penilaian data_rencana_penilaian[]

  @@index([id_mapel], map: "data_kelas_ibfk_2")
  @@index([id_semester], map: "data_kelas_ibfk_3")
  @@index([id_rombel], map: "data_kelas_ibfk_1")
}

model data_kelas_anggota {
  id         Int       @id @default(autoincrement())
  id_kelas   Int?
  id_santri  String?   @db.VarChar(100)
  created_at DateTime? @default(now()) @db.Timestamp(0)
}

model data_kelas_pengajar {
  id         Int       @id
  id_guru    Int?
  id_kelas   Int?
  created_at DateTime? @default(now()) @db.Timestamp(0)
}

model data_nilai_eskul {
  id               Int               @id @default(autoincrement())
  id_santri        Int?
  id_tahun_ajaran  Int?
  nilai            Int?
  id_mapel         Int?
  id_semester      Int?
  created_by       Int?
  updated_by       Int?
  ref_mapel        ref_mapel?        @relation(fields: [id_mapel], references: [id], onDelete: Restrict, onUpdate: Restrict)
  santri           santri?           @relation(fields: [id_santri], references: [id], onDelete: Restrict, onUpdate: Restrict)
  ref_semester     ref_semester?     @relation(fields: [id_semester], references: [id], onDelete: Restrict, onUpdate: Restrict)
  ref_tahun_ajaran ref_tahun_ajaran? @relation(fields: [id_tahun_ajaran], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([id_mapel], map: "data_nilai_eskul_id_mapel_fkey")
  @@index([id_santri], map: "data_nilai_eskul_id_santri_fkey")
  @@index([id_semester], map: "data_nilai_eskul_id_semester_fkey")
  @@index([id_tahun_ajaran], map: "data_nilai_eskul_id_tahun_ajaran_fkey")
}

model data_nilai_kelas {
  id                     Int                    @id @default(autoincrement())
  id_rencana             Int
  id_santri              Int
  nilai                  Decimal?               @db.Decimal(5, 2)
  created_at             DateTime?              @default(now()) @db.Timestamp(0)
  id_kelas               Int?
  id_semester            Int?
  id_tahun_ajaran        Int?
  data_rencana_penilaian data_rencana_penilaian @relation(fields: [id_rencana], references: [id], onUpdate: Restrict, map: "data_nilai_kelas_ibfk_1")

  @@index([id_rencana], map: "id_rencana")
}

model data_nilai_kti {
  id               Int               @id @default(autoincrement())
  id_santri        Int?
  id_tahun_ajaran  Int?
  id_semester      Int?
  nilai            Int?
  judul            String?           @db.VarChar(100)
  santri           santri?           @relation(fields: [id_santri], references: [id], onDelete: Restrict, onUpdate: Restrict)
  ref_semester     ref_semester?     @relation(fields: [id_semester], references: [id], onDelete: Restrict, onUpdate: Restrict)
  ref_tahun_ajaran ref_tahun_ajaran? @relation(fields: [id_tahun_ajaran], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([id_santri], map: "data_nilai_kti_id_santri_fkey")
  @@index([id_semester], map: "data_nilai_kti_id_semester_fkey")
  @@index([id_tahun_ajaran], map: "data_nilai_kti_id_tahun_ajaran_fkey")
}

model data_pengajar {
  id         Int    @id @default(autoincrement())
  thn_ajaran String @db.VarChar(10)
  semester   String @db.VarChar(2)
  kd_guru    String @db.VarChar(5)
  kd_mapel   String @db.VarChar(5)
  kd_kelas   String @db.VarChar(5)
}

model data_penilaian_karakter {
  id                    Int                           @id @default(autoincrement())
  id_tahun_ajaran       Int
  bulan                 Int                           @db.TinyInt
  minggu                Int                           @db.TinyInt
  id_santri             Int
  id_kriteria           Int
  nilai                 data_penilaian_karakter_nilai
  lokasi                basis_lokasi
  created_at            DateTime?                     @default(now()) @db.Timestamp(0)
  updated_at            DateTime?                     @default(now()) @db.Timestamp(0)
  id_semester           Int?
  ref_kriteria_karakter ref_kriteria_karakter         @relation(fields: [id_kriteria], references: [id], onUpdate: Restrict, map: "data_penilaian_karakter_ibfk_1")

  @@index([id_kriteria], map: "id_kriteria")
  @@index([id_santri, id_tahun_ajaran, id_semester, bulan, minggu], map: "indeks_siswa_periode")
}

model data_rencana_penilaian {
  id                 Int                @id @default(autoincrement())
  id_kelas           Int
  id_komponen        Int
  nama               String             @db.VarChar(100)
  pertemuan_ke       Int?
  bobot              Int?               @default(0)
  nilai_maksimum     Decimal?           @default(100.00) @db.Decimal(5, 2)
  keterangan         String?            @db.Text
  created_at         DateTime?          @default(now()) @db.Timestamp(0)
  data_nilai_kelas   data_nilai_kelas[]
  data_kelas         data_kelas         @relation(fields: [id_kelas], references: [id], onUpdate: Restrict, map: "data_rencana_penilaian_ibfk_1")
  ref_komponen_nilai ref_komponen_nilai @relation(fields: [id_komponen], references: [id], onUpdate: Restrict, map: "data_rencana_penilaian_ibfk_2")

  @@index([id_kelas], map: "id_kelas")
  @@index([id_komponen], map: "id_komponen")
}

model ref_jenjang {
  id            Int             @id @default(autoincrement())
  jenjang       String          @db.VarChar(100)
  deskripsi     String?         @db.Text
  ref_kurikulum ref_kurikulum[]
  ref_tingkat   ref_tingkat[]
  ref_unit      ref_unit[]
}

model ref_tingkat {
  id                      Int                     @id @default(autoincrement())
  tingkat                 Int                     @unique @db.TinyInt
  nama                    String?                 @db.VarChar(100)
  id_preferensi_kurikulum Int
  id_jenjang              Int
  deskripsi               String?                 @db.Text
  data_kkm_detail         data_kkm_detail[]
  data_kompetensi_dasar   data_kompetensi_dasar[]
  data_kompetensi_inti    data_kompetensi_inti[]
  ref_kurikulum           ref_kurikulum           @relation(fields: [id_preferensi_kurikulum], references: [id], onUpdate: Restrict, map: "ref_jenjang_ibfk_1")
  ref_jenjang             ref_jenjang             @relation(fields: [id_jenjang], references: [id], onUpdate: Restrict, map: "ref_jenjang_ibfk_2")
  data_rombel             data_rombel[]           @relation(map: "data_rombel_ibfk_1")

  @@index([id_preferensi_kurikulum], map: "ref_jenjang_ibfk_1")
  @@index([id_jenjang], map: "ref_jenjang_ibfk_2")
}

model data_rombel {
  id                              Int                   @id @default(autoincrement())
  id_kelas                        Int?
  id_tahun_ajaran                 Int?
  id_wali_kelas                   Int?
  id_tingkat                      Int?
  created_at                      DateTime?             @default(now()) @db.Timestamp(0)
  id_master_kategori_data_rombel  Int?
  data_kelas                      data_kelas[]
  ref_tingkat                     ref_tingkat?          @relation(fields: [id_tingkat], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "data_rombel_ibfk_5")
  ref_master_kategori_data_rombel ref_master_kategori?  @relation(fields: [id_master_kategori_data_rombel], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "data_rombel_ibfk_1")
  ref_kelas                       ref_kelas?            @relation(fields: [id_kelas], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "data_rombel_ibfk_2")
  ref_tahun_ajaran                ref_tahun_ajaran?     @relation(fields: [id_tahun_ajaran], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "data_rombel_ibfk_3")
  guru_pegawai                    guru_pegawai?         @relation(fields: [id_wali_kelas], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "data_rombel_ibfk_4")
  data_rombel_anggota             data_rombel_anggota[]

  @@index([id_master_kategori_data_rombel], map: "data_rombel_ibfk_1")
  @@index([id_kelas], map: "data_rombel_ibfk_2")
  @@index([id_tahun_ajaran], map: "data_rombel_ibfk_3")
  @@index([id_wali_kelas], map: "data_rombel_ibfk_4")
}

model data_rombel_anggota {
  id                                             Int                  @id @default(autoincrement())
  id_rombel                                      Int?
  id_santri                                      Int?
  created_at                                     DateTime?            @default(now()) @db.Timestamp(0)
  id_master_kategori_status_data_rombel_anggota  Int?
  data_rombel                                    data_rombel?         @relation(fields: [id_rombel], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "data_rombel_anggota_data_rombel_FK")
  ref_master_kategori_status_data_rombel_anggota ref_master_kategori? @relation(fields: [id_master_kategori_status_data_rombel_anggota], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "data_rombel_anggota_ibfk_1")
  santri                                         santri?              @relation(fields: [id_santri], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "data_rombel_anggota_ibfk_2")

  @@index([id_rombel], map: "data_rombel_anggota_data_rombel_FK")
  @@index([id_master_kategori_status_data_rombel_anggota], map: "data_rombel_anggota_ibfk_1")
  @@index([id_santri], map: "data_rombel_anggota_ibfk_2")
}

model data_transaksi_keuangan {
  id           Int                             @id @default(autoincrement())
  tanggal      DateTime                        @db.Date
  nominal      Decimal                         @db.Decimal(15, 2)
  keterangan   String?                         @db.Text
  no_referensi String?                         @db.VarChar(100)
  status       data_transaksi_keuangan_status?
  created_at   DateTime                        @default(now()) @db.Timestamp(0)
  updated_at   DateTime?                       @db.Timestamp(0)
  coa_id       Int
  jurnal_id    Int
  coa          coa                             @relation(fields: [coa_id], references: [id])
  data_jurnal  data_jurnal                     @relation(fields: [jurnal_id], references: [id])

  @@index([coa_id])
  @@index([jurnal_id])
}

model guru_pegawai {
  id                Int           @id @default(autoincrement())
  nip               String        @unique(map: "guru_pegawai_unique") @db.VarChar(35)
  tahun_terdaftar   Int?
  nama_gp           String?       @db.VarChar(100)
  foto_gp           String?       @db.VarChar(100)
  jk                String?       @db.Char(1)
  tempat_ttl        String?       @db.VarChar(100)
  tgl_ttl           DateTime?     @db.Date
  status_pernikahan String?       @db.Char(1)
  jumlah_anak       String?       @db.Char(2)
  pendidikan        String?       @db.VarChar(100)
  jabatan           String?       @db.VarChar(100)
  ket_jabatan       String?       @db.VarChar(100)
  status_gp         String?       @db.Char(1)
  status_kp         String?       @db.Char(1)
  unit              String?       @db.VarChar(100)
  alamat            String?       @db.VarChar(100)
  telepon           String?       @db.VarChar(100)
  foto_ttd          String?       @db.VarChar(100)
  id_unit           Int?
  data_rombel       data_rombel[]
  ref_unit          ref_unit?     @relation(fields: [id_unit], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "guru_pegawai_ibfk_1")

  @@index([id_unit], map: "guru_pegawai_ibfk_1")
}

model jabatan {
  id Int @id @default(autoincrement())
}

model ref_jam {
  id           Int    @id @default(autoincrement())
  jam          String @db.VarChar(11)
  jml_jam      Int?
  jumlah_menit Int?
}

model ref_karakter_kategori {
  id                    Int                     @id @default(autoincrement())
  nama                  String                  @db.VarChar(50)
  deskripsi             String?                 @db.Text
  ref_kriteria_karakter ref_kriteria_karakter[]
}

model ref_kelas {
