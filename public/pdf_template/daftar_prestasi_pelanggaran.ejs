<!DOCTYPE html>
<html>
<head>
    <title>Daftar Prestasi Santri</title>
    <style>
        * {
            font-family: 'Times New Roman', Times, serif;
        }

        body {
            font-family: Arial, sans-serif;
            font-size: 12px;
            margin: 0;
            padding: 0;
        }
        .header {
            display: flex;
            align-items: center;
            margin-bottom: 20px;
            padding-left: 10px;
        }
        .header img {
            width: 80px;
            height: auto;
            margin-right: 20px;
        }
        .header .text-content {
            text-align: left;
        }
        .header h1 {
            font-size: 20px;
            margin: 5px 0;
        }
        .header h2 {
            font-size: 16px;
            margin: 5px 0;
        }
        .header p {
            font-size: 12px;
            margin: 2px 0;
        }
        table {
            width: 100%;
            border-collapse: collapse;
            margin-top: 20px;
            margin-bottom: 20px;
            table-layout: fixed; /* Memastikan lebar kolom tetap */
        }
        th, td {
            border: 1px solid #000;
            padding: 5px;
            text-align: center;
            font-size: 10px;
            overflow-wrap: break-word; /* Memastikan teks panjang terbungkus */
        }
        th {
            background-color: #f2f2f2;
        }
        .footer {
            margin-left: 1000px;
            margin-top: 20px;
            font-size: 12px;
        }
        .class-title {
            text-align: left;
            font-size: 14px;
            margin: 40px 0 10px 0;
        }
    </style>
</head>
<body>
<div class="header">
    <table style="width: 100%;">
        <tr>
            <td style="width: 140px; border: none;">
                <img src="http://66.42.60.252:8000/images/images.png" alt="Logo Shohwatul Is'ad" style="width: 120px; height: auto;">
            </td>
            <td style="text-align: left; padding-left: 30px; border: none;">
                <h2 style="margin: 5px 0; font-size: 18px;">Pondok Pesantren Modern Islam</h2>
                <h1 style="margin: 5px 0; font-size: 26px;">SHOWATUL IS'AD</h1>
                <p style="margin: 3px 0; font-size: 14px;">Jl. Sipiro Marang Kabupaten Pangkep Sulawesi Selatan</p>
                <p style="margin: 3px 0; font-size: 14px;">Telp: (0410) 231559, Fax: (0410) 2317377, www.shohwatulisad.ac.id</p>
            </td>
        </tr>
    </table>
</div>

<h3 style="text-align: center; text-decoration: underline;">DAFTAR PRESTASI SANTRI PPMI SHOHWATUL IS'AD <%= data.tahun_ajaran %> <%= data.bulan %></h3>

<% data.classes.forEach((kelas) => { %>
    <div class="class-title">Kelas: <%= kelas.class_name %></div>
    <table>
        <thead>
        <tr>
            <th style="width: 5%;">No.</th>
            <th style="width: 8%;">NIS</th>
            <th style="width: 20%;">Nama Santri</th>
            <th style="width: 14%;">Judul</th>
            <th style="width: 10%;">Capaian</th>
            <th style="width: 10%;">Tanggal</th>
            <th style="width: 10%;">Tempat</th>
            <th style="width: 23%;">Deskripsi</th>
            <th style="width: 10%;">Kategori</th>
        </tr>
        </thead>
        <tbody>
        <% if (kelas.students.length === 0) { %>
            <tr>
                <td colspan="10">Belum ada prestasi</td>
            </tr>
        <% } else { %>
            <% let index = 1; %>
            <% kelas.students.forEach((santri) => { %>
                <% santri.prestasi.forEach((prestasi) => { %>
                    <tr>
                        <td><%= index++ %></td>
                        <td><%= santri.nis %></td>
                        <td><%= santri.nama %></td>
                        <td><%= prestasi.judul %></td>
                        <td><%= prestasi.capaian %></td>
                        <td><%= prestasi.tanggal %></td>
                        <td><%= prestasi.tempat %></td>
                        <td><%= prestasi.deskripsi %></td>
                        <td><%= prestasi.kategori %></td>
                    </tr>
                <% }) %>
            <% }) %>
        <% } %>
        </tbody>
    </table>
<% }) %>

<div class="footer">
    <div style="text-align: left;">
        <p>Ma'rang, ..........................., 20....</p>
        <p>Bag. Tata Usaha,</p>
        <p style="margin-top: 50px;">(Sunandar, S.Pd.I)</p>
    </div>
</div>
</body>
</html>