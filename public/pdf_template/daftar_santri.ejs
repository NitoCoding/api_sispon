<!DOCTYPE html>
<html>
<head>
    <title>Daftar Nama Santri</title>
    <style>
        * {
            font-family: 'Times New Roman', Times, serif;
        }

        body {
            font-family: Arial, sans-serif;
            font-size: 12px;
            margin: 0;
            padding: 0;
        }
        .header {
            display: flex;
            align-items: center; /* Vertically align logo and text */
            margin-bottom: 20px;
            padding-left: 10px; /* Jarak dari kiri */
        }
        .header img {
            width: 80px;
            height: auto;
            margin-right: 20px; /* Jarak antara logo dan teks */
        }
        .header .text-content {
            text-align: left;
        }
        .header h1 {
            font-size: 20px;
            margin: 5px 0;
        }
        .header h2 {
            font-size: 16px;
            margin: 5px 0;
        }
        .header p {
            font-size: 12px;
            margin: 2px 0;
        }
        table {
            width: 100%;
            border-collapse: collapse;
            margin-top: 20px;
        }
        th, td {
            border: 1px solid #000;
            padding: 5px;
            text-align: center;
            font-size: 10px;
        }
        th {
            background-color: #f2f2f2;
        }
        .footer {
            margin-left: 1000px;
            margin-top: 20px;
            font-size: 12px;
        }
    </style>
</head>
<body>
    <div class="header">
        <table style="width: 100%;">
            <tr>
                <td style="width: 140px; border: none;">
                    <img src="http://66.42.60.252:8000/images/images.png" alt="Logo Shohwatul Is'ad" style="width: 120px; height: auto;">
                </td>
                <td style="text-align: left; padding-left: 30px; border: none;">
                    <h2 style="margin: 5px 0; font-size: 18px;">Pondok Pesantren Modern Islam</h1>
                        <h1 style="margin: 5px 0; font-size: 26px;">SHOWATUL IS'AD</h2>
                    <p style="margin: 3px 0; font-size: 14px;">Jl. Sipiro Marang Kabupaten Pangkep Sulawesi Selatan</p>
                    <p style="margin: 3px 0; font-size: 14px;">Telp: (0410) 231559, Fax: (0410) 2317377, www.shohwatulisad.ac.id</p>
                </td>
            </tr>
        </table>
    </div>


    <h3 style="text-align: center; text-decoration: underline;">DAFTAR NAMA SANTRI PPMI SHOHWATUL IS'AD <%= data.kelas %></h3>

    <table>
        <thead>
        <tr>
            <th>No.</th>
            <th>NIS / NISN</th>
            <th>Nama Santri</th>
            <th>Tempat/Tanggal Lahir</th>
            <th>Alamat</th>
            <th>Asal Sekolah</th>
            <th>Nama Ayah</th>
            <th>Nama Ibu</th>
            <th>Pekerjaan Ayah</th>
            <th>Pekerjaan Ibu</th>
            <th>Penghasilan Ayah</th>
            <th>Penghasilan Ibu</th>
            <th>Telepon</th>
            <th>Penyakit</th>
        </tr>
        </thead>
        <tbody>
        <% data.santri.forEach((s, index) => { %>
            <tr>
                <td><%= index + 1 %></td>
                <td><%= s.nisn %></td>
                <td><%= s.name %></td>
                <td><%= s.birth %></td>
                <td><%= s.address %></td>
                <td><%= s.school %></td>
                <td><%= s.father %></td>
                <td><%= s.mother %></td>
                <td><%= s.fatherJob %></td>
                <td><%= s.motherJob %></td>
                <td><%= s.fatherIncome %></td>
                <td><%= s.motherIncome %></td>
                <td><%= s.phone %></td>
                <td><%= s.disease %></td>
            </tr>
        <% }) %>
        </tbody>
    </table>

    <div class="footer">
        <div style="text-align: left;">
            <p>Ma'rang, ..........................., 20....</p>
            <p>Bag. Tata Usaha,</p>
            <p style="margin-top: 50px;">(Sunandar, S.Pd.I)</p>
        </div>
    </div>
    
</body>
</html>